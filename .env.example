# ─────────────────────────────────────────────────────────────
#  VAELIA · Variables de entorno
#  Copia este archivo como .env y completa tus datos.
#  ¡Nunca subas .env al repositorio!
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3000
# URL pública de la tienda (Webpay vuelve a APP_URL/api/webpay/retorno)
APP_URL=http://localhost:3000
# Solo si el frontend se sirve desde otro dominio (separado por comas)
CORS_ORIGIN=
# 1 si la app corre detrás de un proxy/balanceador HTTPS del hosting
TRUST_PROXY=0

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=vaelia

# Sesiones (genera una con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=
JWT_EXPIRES=7d

# Transbank Webpay Plus
# integration = ambiente de pruebas con las credenciales públicas de Transbank
# production  = requiere código de comercio y API Key entregados por Transbank
TBK_ENV=integration
TBK_COMMERCE_CODE=
TBK_API_KEY=

# Despacho (CLP)
ENVIO_RM=3990
ENVIO_REGIONES=5990
ENVIO_GRATIS_DESDE=60000
# Minutos antes de liberar el stock de un pago abandonado
MINUTOS_EXPIRACION_PAGO=30


# Vercel: clave secreta que autoriza al cron a liberar pedidos abandonados
CRON_SECRET=

# TiDB Cloud u otro MySQL en la nube que exige TLS
DB_SSL=false
